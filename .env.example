# Copy this file to .env and adjust. Never commit .env itself.
APP_NAME=TaskFlow API
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_LEVEL=INFO

# Database container (read by docker-compose.yml)
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow_dev_pw
POSTGRES_DB=taskflow

# App connection string (host port 5433 because the app runs on your machine)
DATABASE_URL=postgresql+psycopg://taskflow:taskflow_dev_pw@localhost:5433/taskflow
